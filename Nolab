// ---------------------------------------------------------------------------
// Shared helper for calling the model. In production this call is swapped
// for an on-device Qwen inference call (see note at bottom of the chat).
// ---------------------------------------------------------------------------
async function askAI(system, userText) {
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system,
      messages: [{ role: "user", content: userText }],
    }),
  });
  const data = await response.json();
  return (data.content || []).map((b) => b.text || "").join("\n").trim();
}

function parseJsonLoose(text) {
  const cleaned = text.replace(/```json|```/g, "").trim();
  const start = cleaned.indexOf("[") === -1 ? cleaned.indexOf("{") : Math.min(...[cleaned.indexOf("["), cleaned.indexOf("{")].filter((i) => i !== -1));
  try {
    return JSON.parse(cleaned.slice(start));
  } catch {
    return null;
  }
}

// ---------------------------------------------------------------------------
// TUTOR MODULE
// ---------------------------------------------------------------------------
function TutorBar() {
  const [content, setContent] = useState("");
  const [loaded, setLoaded] = useState(false);
  const [mode, setMode] = useState("chat");
  const [busy, setBusy] = useState(false);

  const [messages, setMessages] = useState([]);
  const [chatInput, setChatInput] = useState("");
  const [summary, setSummary] = useState("");
  const [quiz, setQuiz] = useState(null);
  const [quizAnswers, setQuizAnswers] = useState({});
  const [quizChecked, setQuizChecked] = useState(false);
  const bottomRef = useRef(null);

  useEffect(() => { bottomRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages]);

  const sys = `You are an offline study tutor. You only use the SOURCE CONTENT below to answer, summarise, or quiz — never outside knowledge. Be concise and student-friendly.\n\nSOURCE CONTENT:\n${content}`;

  async function sendChat() {
    if (!chatInput.trim() || busy) return;
    const q = chatInput.trim();
    setMessages((m) => [...m, { role: "user", text: q }]);
    setChatInput("");
    setBusy(true);
    const reply = await askAI(sys, `Answer this question using only the source content. If the content doesn't cover it, say so plainly.\n\nQuestion: ${q}`);
    setMessages((m) => [...m, { role: "ai", text: reply }]);
    setBusy(false);
  }

  async function runSummary() {
    setBusy(true);
    const reply = await askAI(sys, "Summarise the source content in 5-7 bullet points a student could revise from.");
    setSummary(reply);
    setBusy(false);
  }

  async function runQuiz() {
    setBusy(true);
    setQuizChecked(false);
    setQuizAnswers({});
    const reply = await askAI(
      sys,
      `Write 4 multiple-choice questions testing understanding of the source content. Respond ONLY with JSON, no preamble:
[{"q":"...", "options":["A","B","C","D"], "correct":0}]`
    );
    setQuiz(parseJsonLoose(reply));
    setBusy(false);
  }

  if (!loaded) {
    return (
      <div className="flex flex-col h-full items-center justify-center gap-4 px-6 text-center">
        <BookOpen className="w-10 h-10 text-amber-500" />
        <h2 className="font-serif text-xl text-stone-100">Load your material</h2>
        <p className="text-stone-400 text-sm max-w-sm">Paste notes, a chapter, or a lecture transcript. Everything below runs only on this text — nothing leaves the device.</p>
        <textarea
          value={content}
          onChange={(e) => setContent(e.target.value)}
          placeholder="Paste or type your study content here…"
          className="w-full max-w-md h-40 rounded-lg bg-stone-900 border border-stone-700 text-stone-100 text-sm p-3 focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
        <button
          disabled={!content.trim()}
          onClick={() => setLoaded(true)}
          className="px-5 py-2 rounded-md bg-amber-500 disabled:bg-stone-700 disabled:text-stone-500 text-stone-900 font-medium text-sm hover:bg-amber-400 transition-colors"
        >
          Load content
        </button>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-full">
      <div className="flex gap-1 px-3 pt-3">
        {[
          ["chat", "Chat", MessageSquare],
          ["summary", "Summarise", FileText],
          ["quiz", "Quiz", HelpCircle],
        ].map(([key, label, Icon]) => (
          <button
            key={key}
            onClick={() => setMode(key)}
            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-t-md text-sm font-medium transition-colors ${
              mode === key ? "bg-stone-900 text-amber-400" : "text-stone-400 hover:text-stone-200"
            }`}
          >
            <Icon className="w-3.5 h-3.5" /> {label}
          </button>
        ))}
        <button onClick={() => setLoaded(false)} className="ml-auto text-xs text-stone-500 hover:text-stone-300 self-center pr-2">
          change content
        </button>
      </div>

      <div className="flex-1 bg-stone-900 rounded-b-md rounded-tr-md mx-3 mb-3 p-4 overflow-y-auto">
        {mode === "chat" && (
          <div className="flex flex-col h-full">
            <div className="flex-1 space-y-3 overflow-y-auto">
              {messages.length === 0 && <p className="text-stone-500 text-sm">Ask anything about the loaded content.</p>}
              {messages.map((m, i) => (
                <div key={i} className={`text-sm max-w-[85%] rounded-lg px-3 py-2 ${m.role === "user" ? "ml-auto bg-amber-500 text-stone-900" : "bg-stone-800 text-stone-100"}`}>
                  {m.text}
                </div>
              ))}
              {busy && <Loader2 className="w-4 h-4 animate-spin text-amber-500" />}
              <div ref={bottomRef} />
            </div>
            <div className="flex gap-2 mt-3">
              <input
                value={chatInput}
                onChange={(e) => setChatInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && sendChat()}
                placeholder="Ask a question…"
                className="flex-1 rounded-md bg-stone-800 border border-stone-700 text-stone-100 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500"
              />
              <button onClick={sendChat} className="px-3 rounded-md bg-amber-500 text-stone-900 hover:bg-amber-400">
                <Send className="w-4 h-4" />
              </button>
            </div>
          </div>
        )}

        {mode === "summary" && (
          <div>
            <button onClick={runSummary} disabled={busy} className="mb-3 flex items-center gap-2 px-3 py-1.5 rounded-md bg-amber-500 text-stone-900 text-sm font-medium hover:bg-amber-400 disabled:opacity-50">
              {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <FileText className="w-4 h-4" />} {summary ? "Regenerate" : "Generate summary"}
            </button>
            {summary && <div className="text-sm text-stone-100 whitespace-pre-wrap leading-relaxed">{summary}</div>}
          </div>
        )}

        {mode === "quiz" && (
          <div>
            <button onClick={runQuiz} disabled={busy} className="mb-3 flex items-center gap-2 px-3 py-1.5 rounded-md bg-amber-500 text-stone-900 text-sm font-medium hover:bg-amber-400 disabled:opacity-50">
              {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <HelpCircle className="w-4 h-4" />} {quiz ? "New quiz" : "Generate quiz"}
            </button>
            {quiz && (
              <div className="space-y-4">
                {quiz.map((item, qi) => (
                  <div key={qi} className="text-sm">
                    <p className="text-stone-100 font-medium mb-1.5">{qi + 1}. {item.q}</p>
                    <div className="space-y-1">
                      {item.options.map((opt, oi) => {
                        const chosen = quizAnswers[qi] === oi;
                        const isCorrect = oi === item.correct;
                        let style = "border-stone-700 text-stone-300 hover:border-stone-500";
                        if (quizChecked && chosen && isCorrect) style = "border-emerald-500 bg-emerald-500/10 text-emerald-300";
                        else if (quizChecked && chosen && !isCorrect) style = "border-red-500 bg-red-500/10 text-red-300";
                        else if (quizChecked && isCorrect) style = "border-emerald-500 text-emerald-300";
                        else if (chosen) style = "border-amber-500 text-amber-300";
                        return (
                          <button
                            key={oi}
                            onClick={() => !quizChecked && setQuizAnswers((a) => ({ ...a, [qi]: oi }))}
                            className={`block w-full text-left px-3 py-1.5 rounded-md border text-xs ${style}`}
                          >
                            {opt}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                ))}
                {!quizChecked ? (
                  <button onClick={() => setQuizChecked(true)} className="px-3 py-1.5 rounded-md bg-stone-100 text-stone-900 text-sm font-medium">
                    Check answers
                  </button>
                ) : (
                  <p className="text-xs text-stone-400">
                    Score: {quiz.filter((it, i) => quizAnswers[i] === it.correct).length} / {quiz.length}
                  </p>
                )}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

// ---------------------------------------------------------------------------
// LAB SIMULATOR MODULE
// ---------------------------------------------------------------------------
function LabBar() {
  const [labKey, setLabKey] = useState(null);
  const [procedure, setProcedure] = useState("");
  const [busy, setBusy] = useState(false);
  const [simSteps, setSimSteps] = useState(null);
  const [stepIdx, setStepIdx] = useState(0);

  const lab = labKey ? LABS[labKey] : null;

  async function runSimulation() {
    setBusy(true);
    setStepIdx(0);
    const sys = `You are an offline lab simulation engine for a "${lab.name}" (${lab.subject}) experiment. Preloaded equipment: ${lab.equipment.join(", ")}. The standard step skeleton is: ${lab.steps.map((s, i) => `${i + 1}. ${s}`).join(" | ")}.`;
    const reply = await askAI(
      sys,
      `The student describes their procedure/plan as: "${procedure || "(no notes given, follow the standard skeleton)"}"

For EACH of the ${lab.steps.length} skeleton steps, generate a simulated outcome. Respond ONLY with JSON:
[{"title":"short step title","whatToDo":"1 sentence instruction","observation":"what the simulation shows happening (readings/colour change/etc, be specific and realistic)","tip":"one safety or accuracy tip"}]`
    );
    setSimSteps(parseJsonLoose(reply));
    setBusy(false);
  }

  if (!lab) {
    return (
      <div className="flex flex-col h-full p-4 gap-3">
        <div className="flex items-center gap-2 text-stone-100">
          <FlaskConical className="w-5 h-5 text-teal-400" />
          <h2 className="font-serif text-lg">Choose a preloaded experiment</h2>
        </div>
        <div className="grid gap-2">
          {Object.entries(LABS).map(([key, l]) => (
            <button
              key={key}
              onClick={() => setLabKey(key)}
              className="text-left rounded-lg border border-stone-700 bg-stone-900 hover:border-teal-500 transition-colors p-3"
            >
              <p className="text-stone-100 text-sm font-medium">{l.name}</p>
              <p className="text-stone-500 text-xs">{l.subject} · {l.equipment.length} items preloaded</p>
            </button>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-full p-4 gap-3 overflow-y-auto">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2 text-stone-100">
          <FlaskConical className="w-5 h-5 text-teal-400" />
          <h2 className="font-serif text-lg">{lab.name}</h2>
        </div>
        <button onClick={() => { setLabKey(null); setSimSteps(null); setProcedure(""); }} className="text-xs text-stone-500 hover:text-stone-300">
          change lab
        </button>
      </div>

      <div className="rounded-lg bg-stone-900 border border-stone-700 p-3">
        <p className="text-xs text-teal-400 font-mono mb-1.5 uppercase tracking-wide">Preloaded equipment</p>
        <div className="flex flex-wrap gap-1.5">
          {lab.equipment.map((e) => (
            <span key={e} className="text-xs font-mono text-stone-300 bg-stone-800 rounded px-2 py-0.5">{e}</span>
          ))}
        </div>
      </div>

      {!simSteps && (
        <div className="rounded-lg bg-stone-900 border border-stone-700 p-3">
          <p className="text-xs text-stone-400 mb-2">Describe your procedure or plan (optional — leave blank to follow the standard method):</p>
          <textarea
            value={procedure}
            onChange={(e) => setProcedure(e.target.value)}
            placeholder="e.g. I'll titrate in 1mL increments and slow down near the expected endpoint…"
            className="w-full h-20 rounded-md bg-stone-800 border border-stone-700 text-stone-100 text-sm p-2 focus:outline-none focus:ring-2 focus:ring-teal-500"
          />
          <button
            onClick={runSimulation}
            disabled={busy}
            className="mt-2 flex items-center gap-2 px-3 py-1.5 rounded-md bg-teal-500 text-stone-900 text-sm font-medium hover:bg-teal-400 disabled:opacity-50"
          >
            {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <Play className="w-4 h-4" />} Run simulation
          </button>
        </div>
      )}

      {simSteps && (
        <div className="rounded-lg bg-stone-900 border border-stone-700 p-4 flex-1 flex flex-col">
          <p className="text-xs text-stone-500 font-mono mb-2">STEP {stepIdx + 1} / {simSteps.length}</p>
          <h3 className="text-stone-100 font-medium mb-2">{simSteps[stepIdx]?.title}</h3>
          <p className="text-sm text-stone-300 mb-3">{simSteps[stepIdx]?.whatToDo}</p>
          <div className="rounded-md bg-teal-500/10 border border-teal-700/50 p-3 mb-2">
            <p className="text-xs text-teal-400 font-mono uppercase mb-1">Simulation shows</p>
            <p className="text-sm text-teal-100">{simSteps[stepIdx]?.observation}</p>
          </div>
          <p className="text-xs text-amber-400">⚠ {simSteps[stepIdx]?.tip}</p>
          <div className="mt-auto flex justify-between pt-3">
            <button
              disabled={stepIdx === 0}
              onClick={() => setStepIdx((i) => i - 1)}
              className="flex items-center gap-1 text-sm text-stone-400 disabled:opacity-30 hover:text-stone-200"
            >
              <ChevronLeft className="w-4 h-4" /> Back
            </button>
            <button
              disabled={stepIdx === simSteps.length - 1}
              onClick={() => setStepIdx((i) => i + 1)}
              className="flex items-center gap-1 text-sm text-teal-400 disabled:opacity-30 hover:text-teal-300"
            >
              Next <ChevronRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

